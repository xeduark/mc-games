---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="MC Games - Tu tienda de juegos virtuales para PS4 y PS5" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="min-h-screen font-body bg-white dark:bg-dark-900 text-gray-900 dark:text-gray-100 transition-colors duration-400"
  >
    <slot />

    <!-- Theme Initialization Script -->
    <script>
      const savedTheme = localStorage.getItem('mc-games-theme');
      if (savedTheme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </body>
</html>