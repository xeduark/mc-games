---
// src/components/Footer.astro
import McGamesLogo from './McGamesLogo.astro';

const currentYear = new Date().getFullYear();
---

<footer id="contacto" class="relative border-t transition-colors duration-300 overflow-hidden" style="background-color: var(--color-bg-dark); border-color: var(--color-card-border);">
  <!-- Top Glow Line con Gradiente Dorado -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-[1px]"
    style="background: linear-gradient(90deg, transparent, var(--color-brand-primary), transparent);"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand & Socials -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="p-1 bg-slate-900 rounded-xl border" style="border-color: var(--color-card-border);">
            <McGamesLogo class="w-12 h-9" variant="full" />
          </div>
          <div class="flex flex-col">
            <span class="font-gaming font-black text-xl text-white">
              MC GAMES
            </span>
            <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--color-brand-light);">
              Gold Edition
            </span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-6">
          Tu tienda de confianza para juegos digitales de PlayStation. Los mejores títulos, los mejores precios, atención personalizada por WhatsApp.
        </p>

        <!-- Redes Sociales -->
        <div class="flex items-center gap-3">
          <a
            href="https://instagram.com/mcgames"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-all duration-300 hover:scale-110"
            aria-label="Instagram"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
          <a
            href="https://facebook.com/mcgames"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition-all duration-300 hover:scale-110"
            aria-label="Facebook"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385h-3.047v-3.47h3.047v-2.642c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953h-1.514c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385c5.737-.9 10.125-5.864 10.125-11.854z" />
            </svg>
          </a>
          <a
            href="https://wa.me/573003766780"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-slate-900 border border-emerald-500/30 flex items-center justify-center text-emerald-400 hover:bg-emerald-500 hover:text-slate-950 transition-all duration-300 hover:scale-110 whatsapp-pulse"
            aria-label="WhatsApp"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-gaming font-bold text-sm text-white mb-4 tracking-wider">NAVEGACIÓN</h3>
        <ul class="space-y-3">
          <li>
            <a href="#" class="text-sm text-slate-400 hover:text-amber-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-brand-light);"></span>
              Inicio
            </a>
          </li>
          <li>
            <a href="#catalogo" class="text-sm text-slate-400 hover:text-amber-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-brand-primary);"></span>
              Catálogo de Juegos
            </a>
          </li>
          <li>
            <a href="#" class="text-sm text-slate-400 hover:text-amber-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-brand-dark);"></span>
              Ropa y Merch <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold ml-1">PRÓXIMAMENTE</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/573003766780?text=¡Hola!%20Tengo%20una%20consulta%20🤔" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-400 hover:text-emerald-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Contacto WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact -->
      <div>
        <h3 class="font-gaming font-bold text-sm text-white mb-4 tracking-wider">CONTACTO DIRECTO</h3>
        <p class="text-sm text-slate-400 mb-4">
          ¿Tienes dudas? ¿Quieres un juego que no está en el catálogo? ¡Escríbenos!
        </p>
        <a
          href="https://wa.me/573003766780?text=¡Hola%20MC%20Games!%20🎮%20Necesito%20información"
          target="_blank"
          rel="noopener noreferrer"
          class="tex inline-flex items-center gap-2 px-6 py-3  bg-emerald-500 hover:bg-emerald-600 text-slate-950 rounded-xl font-gaming text-sm font-bold transition-all duration-300 hover:scale-105 shadow-lg shadow-emerald-500/20"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
          </svg>
          +57 300 376 6780
        </a>
      </div>
    </div>

    <!-- Divider & Credits -->
    <div class="border-t border-slate-800/80 mt-12 pt-8">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="text-center md:text-left">
          <p class="text-xs text-slate-400">
            © {currentYear} MC Games. Todos los derechos reservados.
          </p>
          <p class="text-xs text-slate-400 mt-1">
            Página desarrollada y patrocinada por
            <a
              href="https://github.com/xeduark"
              target="_blank"
              rel="noopener noreferrer"
              class="font-bold hover:underline"
              style="color: var(--color-brand-light);"
            >
              Xeduark Dev
            </a>
            💻✨
          </p>
        </div>

        <div class="flex items-center gap-4">
          <a
            href="https://wa.me/573003766780?text=Hola%20Xeduark%20Dev,%20me%20interesa%20el%20desarrollo%20web"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs text-slate-400 hover:text-amber-400 transition-colors"
          >
            Contacto Dev
          </a>
          <span class="text-slate-700">|</span>
          <span class="text-xs text-slate-400 flex items-center gap-1">
            Hecho con
            <span class="text-red-500 animate-pulse">❤️</span>
            y mucho ☕
          </span>
        </div>
      </div>
    </div>
  </div>
</footer>