---
// src/components/Footer.astro
import McGamesLogo from './McGamesLogo.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';

const currentYear = new Date().getFullYear();

// Diccionario de Redes Sociales (Static Component Mapping)
const SOCIAL_NETWORKS = [
  {
    name: "Instagram",
    href: "https://instagram.com/mcgames",
    class: "social-link-default",
    icon: InstagramIcon
  },
  {
    name: "Facebook",
    href: "https://facebook.com/mcgames",
    class: "social-link-default",
    icon: FacebookIcon
  },
  {
    name: "WhatsApp",
    href: "https://wa.me/573003766780",
    class: "social-link-whatsapp whatsapp-pulse",
    icon: WhatsAppIcon
  }
];
---

<footer id="contacto" class="relative border-t transition-colors duration-300 overflow-hidden" style="background-color: var(--color-bg-dark); border-color: var(--color-card-border);">
  <!-- Top Glow Line con Gradiente Dorado -->
  <div
    class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-[1px]"
    style="background: linear-gradient(90deg, transparent, var(--color-brand-primary), transparent);"
  ></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand & Socials -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="p-1 bg-slate-900 rounded-xl border" style="border-color: var(--color-card-border);">
            <McGamesLogo class="w-12 h-9" variant="full" />
          </div>
          <div class="flex flex-col">
            <span class="font-gaming font-black text-xl text-white">
              MC GAMES
            </span>
            <span class="text-[10px] font-bold uppercase tracking-widest" style="color: var(--color-brand-light);">
              The world is yours
            </span>
          </div>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-6">
          Tu tienda de confianza para juegos digitales de PlayStation. Los mejores títulos, los mejores precios, atención personalizada por WhatsApp.
        </p>

        <!-- Redes Sociales Generadas Dinámicamente -->
        <div class="flex items-center gap-3">
          {SOCIAL_NETWORKS.map((network) => {
            const Icon = network.icon;
            return (
              <a
                href={network.href}
                target="_blank"
                rel="noopener noreferrer"
                class={`w-10 h-10 rounded-full border flex items-center justify-center transition-all duration-300 hover:scale-110 ${network.class}`}
                aria-label={network.name}
              >
                <Icon class="w-5 h-5" />
              </a>
            )
          })}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-gaming font-bold text-sm text-white mb-4 tracking-wider">NAVEGACIÓN</h3>
        <ul class="space-y-3">
          <li>
            <a href="#" class="text-sm text-slate-400 hover:text-amber-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-brand-light);"></span>
              Inicio
            </a>
          </li>
          <li>
            <a href="#catalogo" class="text-sm text-slate-400 hover:text-amber-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-brand-primary);"></span>
              Catálogo de Juegos
            </a>
          </li>
          <li>
            <a href="#" class="text-sm text-slate-400 hover:text-amber-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full" style="background-color: var(--color-brand-dark);"></span>
              Ropa y Merch <span class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 font-bold ml-1">PRÓXIMAMENTE</span>
            </a>
          </li>
          <li>
            <a href="https://wa.me/573003766780?text=¡Hola!%20Tengo%20una%20consulta%20🤔" target="_blank" rel="noopener noreferrer" class="text-sm text-slate-400 hover:text-emerald-400 transition-colors duration-300 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Contacto WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact -->
      <div>
        <h3 class="font-gaming font-bold text-sm text-white mb-4 tracking-wider">CONTACTO DIRECTO</h3>
        <p class="text-sm text-slate-400 mb-4">
          ¿Tienes dudas? ¿Quieres un juego que no está en el catálogo? ¡Escríbenos!
        </p>
        <a
          href="https://wa.me/573003766780?text=¡Hola%20MC%20Games!%20🎮%20Necesito%20información"
          target="_blank"
          rel="noopener noreferrer"
          class="font-gaming text-sm font-bold rounded-xl px-6 py-3 transition-all duration-300 hover:scale-105 inline-flex items-center gap-2 btn-footer-whatsapp"
        >
          <WhatsAppIcon class="w-5 h-5" />
          +57 300 376 6780
        </a>
      </div>
    </div>
    
    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-slate-800/60 text-center text-xs text-slate-500">
      &copy; {currentYear} MC GAMES. Todos los derechos reservados.
    </div>
  </div>
</footer>
