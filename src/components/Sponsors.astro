---
// Lista de sponsors/clientes - Puedes agregar más aquí
const sponsors = [
  {
    name: 'Cliente Ejemplo 1',
    logo: 'https://via.placeholder.com/150x80/1a1a1a/FFFFFF?text=CLIENTE+1',
    url: '#',
    description: 'Descripción del cliente'
  },
  {
    name: 'Cliente Ejemplo 2',
    logo: 'https://via.placeholder.com/150x80/1a1a1a/FFFFFF?text=CLIENTE+2',
    url: '#',
    description: 'Otro cliente importante'
  },
  {
    name: 'Cliente Ejemplo 3',
    logo: 'https://via.placeholder.com/150x80/1a1a1a/FFFFFF?text=CLIENTE+3',
    url: '#',
    description: 'Marca aliada'
  }
];

// 👇 TU INFORMACIÓN COMO DESARROLLADOR
const developer = {
  name: 'Tu Nombre', // Reemplaza con tu nombre real
  role: 'Desarrollador & Fundador',
  bio: 'Desarrollador web full-stack especializado en crear experiencias digitales únicas. Fundador de MC Games.',
  email: 'tuemail@ejemplo.com', // Reemplaza con tu email
  whatsapp: '3003766780',
  github: 'tuusuario', // Reemplaza con tu usuario de GitHub
  linkedin: 'tuusuario', // Reemplaza con tu usuario de LinkedIn
  portfolio: 'https://tuportafolio.com' // Reemplaza con tu portafolio
};
---

<section class="relative py-16 md:py-20 px-4 bg-slate-950 border-t border-slate-800/50">
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-amber-500/5 via-transparent to-transparent pointer-events-none"></div>
  
  <div class="max-w-6xl mx-auto relative z-10">
    <!-- Título de la sección -->
    <div class="text-center mb-10 md:mb-12">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-slate-800/80 border border-slate-700 text-slate-400 text-xs font-gaming font-bold tracking-wider mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
        SPONSORS & DESARROLLADOR
      </span>
      <h2 class="font-gaming font-black text-2xl md:text-3xl text-white mb-3">
        Conoce al <span class="text-amber-400">Equipo</span>
      </h2>
      <p class="text-slate-400 text-sm max-w-xl mx-auto">
        Desarrollador y marcas que hacen posible este proyecto
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8 mb-10">
      
      <!-- 👇 TU BLOQUE COMO DESARROLLADOR (Destacado) -->
      <div class="relative group">
        <div class="absolute -inset-0.5 bg-gradient-to-r from-amber-500 to-purple-600 rounded-2xl opacity-30 group-hover:opacity-50 blur transition duration-300"></div>
        <div class="relative h-full p-6 md:p-8 rounded-2xl bg-slate-900 border border-slate-700">
          <div class="flex flex-col items-center text-center">
            <!-- Avatar/Logo del Desarrollador -->
            <div class="w-20 h-20 md:w-24 md:h-24 rounded-full bg-gradient-to-br from-amber-500 to-purple-600 flex items-center justify-center shadow-lg shadow-amber-500/30 mb-4">
              <svg class="w-10 h-10 md:w-12 md:h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>

            <h3 class="font-gaming font-black text-xl md:text-2xl text-white mb-1">{developer.name}</h3>
            <p class="text-amber-400 font-bold text-sm mb-3">{developer.role}</p>
            <p class="text-slate-400 text-xs md:text-sm mb-5 leading-relaxed">
              {developer.bio}
            </p>

            <!-- Redes Sociales -->
            <div class="flex items-center gap-3 mb-5">
              <!-- GitHub -->
              <a 
                href={`https://github.com/${developer.github}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="p-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all"
                title="GitHub"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              </a>

              <!-- LinkedIn -->
              <a 
                href={`https://linkedin.com/in/${developer.linkedin}`} 
                target="_blank" 
                rel="noopener noreferrer"
                class="p-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all"
                title="LinkedIn"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>

              <!-- Email -->
              <a 
                href={`mailto:${developer.email}`}
                class="p-2.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white transition-all"
                title="Email"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </a>

              <!-- WhatsApp -->
              <a 
                href={`https://wa.me/${developer.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2.5 rounded-lg bg-slate-800 hover:bg-emerald-600 text-slate-400 hover:text-white transition-all"
                title="WhatsApp"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </a>
            </div>

            <!-- Botón de Portafolio -->
            <a 
              href={developer.portfolio}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-purple-600 text-white font-gaming font-bold text-xs hover:shadow-lg hover:shadow-amber-500/30 transition-all hover:scale-105"
            >
              <span>Ver Portafolio</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- 👇 GRID DE SPONSORS/CLIENTES -->
      <div class="grid grid-cols-2 gap-4">
        {sponsors.map((sponsor) => (
          <a
            href={sponsor.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative p-4 rounded-xl bg-slate-900/60 border border-slate-800 hover:border-slate-600 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 flex flex-col items-center justify-center text-center"
          >
            <div class="aspect-[16/9] flex items-center justify-center mb-2 w-full">
              <img 
                src={sponsor.logo} 
                alt={sponsor.name}
                class="max-w-full max-h-12 object-contain opacity-70 group-hover:opacity-100 transition-opacity grayscale group-hover:grayscale-0"
              />
            </div>
            <h3 class="font-gaming font-bold text-xs text-slate-300 group-hover:text-white transition-colors">
              {sponsor.name}
            </h3>
          </a>
        ))}

        <!-- Espacio para agregar más sponsors -->
        <a
          href={`https://wa.me/3003766780?text=¡Hola!%20Me%20interesa%20ser%20sponsor%20de%20MC%20Games`}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative rounded-xl border-2 border-dashed border-slate-700 hover:border-amber-500/50 transition-all duration-300 flex flex-col items-center justify-center gap-2 hover:bg-slate-900/40 p-4"
        >
          <div class="w-10 h-10 rounded-full bg-slate-800 group-hover:bg-amber-500/20 flex items-center justify-center transition-colors">
            <svg class="w-5 h-5 text-slate-500 group-hover:text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
            </svg>
          </div>
          <span class="font-gaming font-bold text-[10px] text-slate-500 group-hover:text-amber-400 text-center">
            ¿Ser sponsor?
          </span>
        </a>
      </div>
    </div>

    <!-- Nota al pie -->
    <div class="text-center">
      <p class="text-slate-500 text-xs">
        ¿Interesado en colaborar con nosotros? 
        <a href={`https://wa.me/3003766780`} target="_blank" rel="noopener noreferrer" class="text-amber-400 hover:text-amber-300 font-bold transition-colors">
          Contáctanos
        </a>
      </p>
    </div>
  </div>
</section>