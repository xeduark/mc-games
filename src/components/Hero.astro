---
// Hero.astro - Sección Principal con Variables de CSS de MC GAMES Gold Edition
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden gradient-bg-animated hero-grid pt-28 md:pt-36">
  <!-- Animated Background Orbs usando CSS Custom Properties -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="absolute top-1/4 left-1/4 w-72 h-72 rounded-full blur-3xl animate-float"
      style="background-color: var(--color-brand-glow); opacity: 0.25;"
    ></div>
    <div
      class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl animate-float"
      style="background-color: var(--color-brand-dark); opacity: 0.15; animation-delay: -3s;"
    ></div>
    <div
      class="absolute top-1/2 left-1/2 w-64 h-64 rounded-full blur-3xl animate-float"
      style="background-color: var(--color-brand-light); opacity: 0.1; animation-delay: -1.5s;"
    ></div>
  </div>

  <!-- Floating Particles con var(--color-brand-light) -->
  <div class="absolute inset-0 pointer-events-none">
    {Array.from({ length: 20 }).map((_, i) => (
      <div
        class="particle"
        style={`width: ${Math.random() * 4 + 2}px; height: ${Math.random() * 4 + 2}px; top: ${Math.random() * 100}%; left: ${Math.random() * 100}%; background-color: var(--color-brand-light); opacity: 0.4; animation-delay: ${Math.random() * 6}s; animation-duration: ${Math.random() * 4 + 4}s;`}
      ></div>
    ))}
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
    <!-- Badge con Variables de CSS -->
    <div
      class="inline-flex items-center gap-2 px-4 py-2 rounded-full border mb-8 animate-fade-in shadow-md"
      style="background-color: rgba(245, 158, 11, 0.1); border-color: var(--color-card-border);"
    >
      <span class="w-2 h-2 rounded-full animate-pulse" style="background-color: var(--color-whatsapp);"></span>
      <span class="text-xs md:text-sm font-bold tracking-wide" style="color: var(--color-brand-light);">
        Nuevos títulos disponibles
      </span>
    </div>

    <!-- Title -->
    <h1 class="font-gaming font-black text-5xl sm:text-6xl md:text-7xl lg:text-8xl mb-6 animate-slide-up">
      <span class="block text-white">BIENVENIDO A</span>
      <span
        class="block bg-clip-text text-transparent glow-text bg-[length:200%_auto] animate-gradient-x"
        style="background-image: linear-gradient(to right, var(--color-brand-light), var(--color-brand-primary), var(--color-brand-dark));"
      >
        MC GAMES
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto mb-10 animate-slide-up" style="animation-delay: 0.2s">
      Tu destino definitivo para juegos en formato digital de
      <span class="font-bold" style="color: var(--color-brand-light);">PlayStation</span> y más.
      Los mejores títulos a los mejores precios, directo a tu WhatsApp.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.4s">
      <!-- Ver Catálogo CTA (Gradiente Dorado de la Marca) -->
      <a
        href="#catalogo"
        class="group relative px-8 py-4 text-slate-950 font-gaming font-black rounded-xl text-lg overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-lg shadow-amber-500/25"
        style="background: linear-gradient(to right, var(--color-brand-light), var(--color-brand-primary));"
      >
        <span class="relative z-10 flex items-center gap-2">
          Ver Catálogo
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
        <div
          class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
          style="background: linear-gradient(to right, var(--color-brand-primary), var(--color-brand-dark));"
        ></div>
      </a>

      <!-- WhatsApp CTA (Verde Oficial WhatsApp) -->
      <a
        href="https://wa.me/573000000000?text=¡Hola!%20Quiero%20información%20sobre%20los%20juegos%20disponibles%20🎮"
        target="_blank"
        rel="noopener noreferrer"
        class="px-8 py-4 border-2 font-gaming font-bold rounded-xl text-lg transition-all duration-300 hover:scale-105 flex items-center gap-2 shadow-lg whatsapp-pulse"
        style="border-color: var(--color-whatsapp); color: var(--color-whatsapp);"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        WhatsApp
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-3 gap-8 mt-16 max-w-lg mx-auto animate-slide-up" style="animation-delay: 0.6s">
      <div class="text-center">
        <div class="font-gaming font-bold text-2xl md:text-3xl" style="color: var(--color-brand-light);">12+</div>
        <div class="text-xs md:text-sm text-slate-400 mt-1">Juegos</div>
      </div>
      <div class="text-center">
        <div class="font-gaming font-bold text-2xl md:text-3xl" style="color: var(--color-brand-primary);">PS4/5</div>
        <div class="text-xs md:text-sm text-slate-400 mt-1">Plataformas</div>
      </div>
      <div class="text-center">
        <div class="font-gaming font-bold text-2xl md:text-3xl text-emerald-400">24/7</div>
        <div class="text-xs md:text-sm text-slate-400 mt-1">Atención</div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator con Borde de Variable CSS -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce-slow">
    <div class="w-6 h-10 rounded-full border-2 flex items-start justify-center p-1" style="border-color: var(--color-card-border);">
      <div class="w-1.5 h-3 rounded-full animate-bounce" style="background-color: var(--color-brand-light);"></div>
    </div>
  </div>
</section>