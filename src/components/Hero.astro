<section class="relative min-h-screen flex items-center justify-center overflow-hidden gradient-bg-animated hero-grid pt-28 md:pt-36">
  <!-- Animated Background Orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-72 h-72 bg-neon-blue/10 dark:bg-neon-blue/20 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-neon-purple/10 dark:bg-neon-purple/20 rounded-full blur-3xl animate-float" style="animation-delay: -3s"></div>
    <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-neon-pink/5 dark:bg-neon-pink/10 rounded-full blur-3xl animate-float" style="animation-delay: -1.5s"></div>
  </div>

  <!-- Floating Particles -->
  <div class="absolute inset-0 pointer-events-none">
    {Array.from({ length: 20 }).map((_, i) => (
      <div
        class="particle bg-neon-blue/30 dark:bg-neon-blue/50"
        style={`width: ${Math.random() * 4 + 2}px; height: ${Math.random() * 4 + 2}px; top: ${Math.random() * 100}%; left: ${Math.random() * 100}%; animation-delay: ${Math.random() * 6}s; animation-duration: ${Math.random() * 4 + 4}s;`}
      ></div>
    ))}
  </div>

  <!-- Content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-neon-blue/10 dark:bg-neon-blue/10 border border-neon-blue/20 dark:border-neon-blue/30 mb-8 animate-fade-in">
      <span class="w-2 h-2 rounded-full bg-neon-green animate-pulse"></span>
      <span class="text-xs md:text-sm font-medium text-neon-blue"> Nuevos títulos disponibles</span>
    </div>

    <!-- Title -->
    <h1 class="font-gaming font-black text-5xl sm:text-6xl md:text-7xl lg:text-8xl mb-6 animate-slide-up">
      <span class="block text-gray-900 dark:text-white">BIENVENIDO A</span>
      <span class="block bg-gradient-to-r from-neon-blue via-neon-purple to-neon-pink bg-clip-text text-transparent glow-text bg-[length:200%_auto] animate-gradient-x">
        MC GAMES
      </span>
    </h1>

    <!-- Subtitle ACTUALIZADO -->
    <p class="text-lg md:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-10 animate-slide-up" style="animation-delay: 0.2s">
      Tu destino definitivo para juegos de
      <span class="text-neon-blue font-semibold">PlayStation</span>,
      <span class="text-neon-purple font-semibold">Xbox Series S/X</span> y más.
      Los mejores títulos a los mejores precios, directo a tu WhatsApp. 🚀
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 0.4s">
      <a href="#catalogo" class="group relative px-8 py-4 bg-gradient-to-r from-neon-blue to-neon-purple text-white font-gaming font-bold rounded-xl text-lg overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-neon-blue/25">
        <span class="relative z-10 flex items-center gap-2">
          Ver Catálogo
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
        <div class="absolute inset-0 bg-gradient-to-r from-neon-purple to-neon-pink opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </a>

      <a href="https://wa.me/1234567890?text=¡Hola!%20Quiero%20información%20sobre%20los%20juegos%20disponibles%20🎮" target="_blank" rel="noopener noreferrer" class="px-8 py-4 border-2 border-green-500 text-green-500 font-gaming font-bold rounded-xl text-lg hover:bg-green-500 hover:text-white transition-all duration-300 hover:scale-105 flex items-center gap-2">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        WhatsApp
      </a>
    </div>

    <!-- Stats ACTUALIZADO: PS4/5 → Xbox S/X -->
    <div class="grid grid-cols-3 gap-8 mt-16 max-w-lg mx-auto animate-slide-up" style="animation-delay: 0.6s">
      <div class="text-center">
        <div class="font-gaming font-bold text-2xl md:text-3xl text-neon-blue">12+</div>
        <div class="text-xs md:text-sm text-gray-500 dark:text-gray-400 mt-1">Juegos</div>
      </div>
      <div class="text-center">
        <div class="font-gaming font-bold text-2xl md:text-3xl text-neon-purple">Xbox S/X</div>
        <div class="text-xs md:text-sm text-gray-500 dark:text-gray-400 mt-1">Plataformas</div>
      </div>
      <div class="text-center">
        <div class="font-gaming font-bold text-2xl md:text-3xl text-neon-pink">24/7</div>
        <div class="text-xs md:text-sm text-gray-500 dark:text-gray-400 mt-1">Atención</div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce-slow">
    <div class="w-6 h-10 rounded-full border-2 border-neon-blue/50 flex items-start justify-center p-1">
      <div class="w-1.5 h-3 bg-neon-blue rounded-full animate-bounce"></div>
    </div>
  </div>
</section>