---
import { games, WHATSAPP_NUMBER, WHATSAPP_MESSAGES } from "../data/games";
---

<div
  id="game-modal"
  class="hidden fixed inset-0 z-[100] items-center justify-center p-4 modal-backdrop bg-black/80 backdrop-blur-md"
>
  <div
    id="modal-content"
    class="relative w-full max-w-3xl max-h-[90vh] overflow-y-auto rounded-3xl border shadow-2xl text-white"
    style="background-color: var(--color-card-bg); border-color: var(--color-card-border);"
  >
  </div>
</div>

<script
  define:vars={{
    wNumber: WHATSAPP_NUMBER,
    wBuyMsg: WHATSAPP_MESSAGES.buyGame,
    gamesData: games,
  }}
>
  let currentAccountType = "primaria";
  let currentPlatform = "PS4";

  function formatCOP(amount) {
    return new Intl.NumberFormat("es-CO", {
      style: "currency",
      currency: "COP",
      minimumFractionDigits: 0,
      maximumFractionDigits: 0,
    }).format(amount);
  }

  /*
   * ==========================================================
   * BUSCAR JUEGO
   * ==========================================================
   */

  function getGame(gameId) {
    return gamesData.find((game) => game.id === gameId);
  }

  /*
   * ==========================================================
   * CLICK EN "VER DETALLES"
   * ==========================================================
   */

  document.addEventListener("click", function (e) {
    const target = e.target;

    if (!(target instanceof Element)) return;

    /*
     * No interferir con enlaces de WhatsApp.
     */
    if (target.closest('a[href*="wa.me"]')) return;

    const btn = target.closest(".btn-ver-detalles");

    if (!btn) return;

    const gameId = btn.getAttribute("data-game-id");

    if (!gameId) return;

    currentAccountType = "primaria";

    openModal(gameId);
  });

  /*
   * ==========================================================
   * ABRIR MODAL
   * ==========================================================
   */

  function openModal(gameId) {
    const modal = document.getElementById("game-modal");
    const modalContent = document.getElementById("modal-content");

    if (
      !modal ||
      !modalContent ||
      !(modal instanceof HTMLElement) ||
      !(modalContent instanceof HTMLElement)
    ) {
      return;
    }

    /*
     * Obtener juego directamente desde games.ts.
     */

    const game = getGame(gameId);

    if (!game) {
      console.error("No se encontró el juego:", gameId);
      return;
    }

    /*
     * ========================================================
     * DATOS DEL JUEGO
     * ========================================================
     */

    const title = game.title;
    const image = game.image;
    const genre = game.genre;
    const year = String(game.releaseYear);
    const stars = game.rating;
    const synopsis = game.synopsis;
    const platforms = game.platforms;

    /*
     * Si no tiene plataformas, no podemos mostrar el modal.
     */

    if (!platforms.length) return;

    /*
     * ========================================================
     * PLATAFORMA INICIAL
     *
     * Si existe PS4, comenzamos en PS4.
     * Si no, comenzamos en PS5.
     * ========================================================
     */

    currentPlatform = platforms.some((platform) => platform.name === "PS4")
      ? "PS4"
      : "PS5";

    /*
     * ========================================================
     * RENDERIZAR CONTENIDO
     * ========================================================
     */

    function getCurrentPlatform() {
      return platforms.find((platform) => platform.name === currentPlatform);
    }

    function renderModalContent() {
      const currentPlatformData = getCurrentPlatform();

      if (!currentPlatformData) return;

      /*
       * ======================================================
       * PRECIO
       * ======================================================
       */

      const currentPrice =
        currentAccountType === "primaria"
          ? currentPlatformData.pricePrimaria
          : currentPlatformData.priceSecundaria;

      /*
       * ======================================================
       * PLATAFORMAS DISPONIBLES
       * ======================================================
       */

      const availablePlatforms = platforms.map((platform) => platform.name);

      const ps4Available = availablePlatforms.includes("PS4");

      const ps5Available = availablePlatforms.includes("PS5");

      /*
       * ======================================================
       * SELECTOR DE PLATAFORMA
       * ======================================================
       */

      const platformButtons = [];

      if (ps4Available) {
        platformButtons.push(`
          <button
            id="platform-ps4"
            type="button"
            class="flex-1 py-2.5 rounded-xl text-xs font-bold transition-all ${
              currentPlatform === "PS4"
                ? "bg-[#003791] text-white shadow-lg"
                : "bg-slate-800/80 text-slate-300 hover:text-white border border-slate-700/50"
            }"
          >
            🎮 PS4
          </button>
        `);
      }

      if (ps5Available) {
        platformButtons.push(`
          <button
            id="platform-ps5"
            type="button"
            class="flex-1 py-2.5 rounded-xl text-xs font-bold transition-all ${
              currentPlatform === "PS5"
                ? "bg-white text-black shadow-lg"
                : "bg-slate-800/80 text-slate-300 hover:text-white border border-slate-700/50"
            }"
          >
            🎮 PS5
          </button>
        `);
      }

      /*
       * ======================================================
       * SELECTOR PRIMARIA / SECUNDARIA
       * ======================================================
       */

      const btnSecClass =
        currentAccountType === "secundaria"
          ? "bg-amber-500 text-slate-950 font-black shadow-lg"
          : "bg-slate-800/80 text-slate-300 hover:text-white border border-slate-700/50";

      const btnPriClass =
        currentAccountType === "primaria"
          ? "bg-amber-500 text-slate-950 font-black shadow-lg"
          : "bg-slate-800/80 text-slate-300 hover:text-white border border-slate-700/50";

      /*
       * ======================================================
       * WHATSAPP
       * ======================================================
       */

      const accountLabel =
        currentAccountType === "primaria"
          ? "Cuenta Primaria"
          : "Cuenta Secundaria";

      const platformsTextForWA = `${currentPlatform} ${accountLabel} (${formatCOP(currentPrice)})`;

      const waMsg = wBuyMsg
        .replace("{title}", title)
        .replace("{platforms}", platformsTextForWA);

      const whatsappUrl =
        "https://wa.me/" + wNumber + "?text=" + encodeURIComponent(waMsg);

      /*
       * ======================================================
       * PRECIO ANTERIOR
       * ======================================================
       */

      const oldPrice = formatCOP(Math.round(currentPrice * 1.3));

      /*
       * ======================================================
       * ESTRELLAS
       * ======================================================
       */

      let starsHtml = "";

      for (let i = 0; i < 5; i++) {
        starsHtml +=
          '<span class="text-xl ' +
          (i < stars
            ? "star-filled text-amber-400"
            : "star-empty text-slate-700") +
          '">★</span>';
      }

      /*
       * ======================================================
       * INFORMACIÓN DE PLATAFORMA
       * ======================================================
       */

      const platformLabel = currentPlatform === "PS4" ? "PS4" : "PS5";

      const platformColor = currentPlatform === "PS4" ? "#003791" : "#ffffff";

      const platformTextColor =
        currentPlatform === "PS4" ? "#ffffff" : "#000000";

      /*
       * ======================================================
       * HTML DEL MODAL
       * ======================================================
       */

      modalContent.innerHTML = `
        <div
          class="relative flex flex-col md:flex-row animate-scale-in overflow-hidden rounded-3xl"
        >

          <!-- =================================================
               CERRAR
               ================================================= -->

          <button
            id="close-modal"
            type="button"
            class="absolute top-4 right-4 z-20 w-10 h-10 rounded-full bg-slate-800/80 backdrop-blur-sm flex items-center justify-center text-slate-300 hover:text-white hover:bg-red-500 transition-colors duration-300"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              />
            </svg>
          </button>


          <!-- =================================================
               IMAGEN
               ================================================= -->

          <div
            class="w-full md:w-5/12 relative bg-slate-950 flex-shrink-0 min-h-[280px] md:min-h-full border-b md:border-b-0 md:border-r border-slate-800/80 overflow-hidden"
          >

            <img
              src="${image}"
              alt="${title}"
              class="w-full h-full min-h-[280px] md:absolute md:inset-0 object-cover object-center"
            />

            <!-- Plataforma -->

            <div
              class="absolute top-4 left-4 px-3 py-2 rounded-xl font-black text-sm shadow-xl"
              style="background:${platformColor}; color:${platformTextColor};"
            >
              ${platformLabel}
            </div>

          </div>


          <!-- =================================================
               DETALLE
               ================================================= -->

          <div
            class="w-full md:w-7/12 p-6 md:p-8 bg-slate-900 text-white flex flex-col justify-between"
          >

            <div>

              <!-- TÍTULO -->

              <h2
                class="font-gaming font-black text-2xl md:text-3xl text-white mb-3 tracking-tight"
              >
                ${title}
              </h2>


              <!-- PLATAFORMA -->

              <div class="mb-4">

                <p
                  class="text-[10px] uppercase tracking-wider text-slate-500 font-bold mb-2"
                >
                  Plataforma
                </p>

                <div
                  class="flex items-center gap-2 p-1.5 bg-slate-950 rounded-2xl border border-slate-800"
                >
                  ${platformButtons.join("")}
                </div>

              </div>


              <!-- TIPO DE CUENTA -->

              <div class="mb-6">

                <p
                  class="text-[10px] uppercase tracking-wider text-slate-500 font-bold mb-2"
                >
                  Tipo de cuenta
                </p>

                <div
                  class="flex items-center gap-2 p-1.5 bg-slate-950 rounded-2xl border border-slate-800"
                >

                  <button
                    id="toggle-sec"
                    type="button"
                    class="flex-1 py-2 rounded-xl text-xs font-bold transition-all duration-300 ${btnSecClass}"
                  >
                    Secundaria
                  </button>

                  <button
                    id="toggle-pri"
                    type="button"
                    class="flex-1 py-2 rounded-xl text-xs font-bold transition-all duration-300 ${btnPriClass}"
                  >
                    Primaria
                  </button>

                </div>

              </div>


              <!-- INFO -->

              <div
                class="flex items-center gap-3 mb-4"
              >

                <span
                  class="text-xs text-slate-400 font-medium"
                >
                  ${genre}
                </span>

                <span class="text-slate-700">
                  •
                </span>

                <span
                  class="text-xs text-slate-400 font-medium"
                >
                  ${year}
                </span>

              </div>


              <!-- ESTRELLAS -->

              <div
                class="flex items-center gap-1 mb-5"
              >

                ${starsHtml}

                <span
                  class="text-xs text-slate-400 ml-2 font-bold"
                >
                  (${stars}.0 / 5.0)
                </span>

              </div>


              <!-- PRECIO -->

              <div
                class="mb-6 bg-slate-950/80 p-4 rounded-2xl border border-slate-800/80"
              >

                <h3
                  class="font-gaming font-bold text-xs text-amber-400 mb-3 uppercase tracking-wider"
                >
                  🎮 PRECIO DISPONIBLE
                </h3>

                <div
                  class="flex justify-between items-center"
                >

                  <span
                    class="text-slate-300 font-medium text-sm"
                  >
                    ${currentPlatform} · ${
                      currentAccountType === "primaria"
                        ? "Primaria"
                        : "Secundaria"
                    }
                  </span>

                  <span
                    class="font-gaming font-bold text-amber-400 text-lg"
                  >
                    ${formatCOP(currentPrice)}
                  </span>

                </div>

              </div>


              <!-- SINOPSIS -->

              <div class="mb-6">

                <h3
                  class="font-gaming font-bold text-xs text-amber-400 mb-2 uppercase tracking-wider"
                >
                  SINOPSIS
                </h3>

                <p
                  class="text-xs sm:text-sm text-slate-300 leading-relaxed"
                >
                  ${synopsis}
                </p>

              </div>

            </div>


            <!-- =================================================
                 PRECIO FINAL
                 ================================================= -->

            <div>

              <div
                class="flex items-center gap-4 mb-5 pt-4 border-t border-slate-800"
              >

                <span
                  class="font-gaming font-black text-2xl sm:text-3xl text-amber-400"
                >
                  ${formatCOP(currentPrice)}
                </span>

                <span
                  class="text-xs sm:text-sm text-slate-500 line-through"
                >
                  ${oldPrice}
                </span>

                <span
                  class="px-2 py-0.5 rounded-md bg-red-500/20 text-red-400 text-xs font-bold"
                >
                  -30% OFF
                </span>

              </div>


              <!-- WHATSAPP -->

              <a
                href="${whatsappUrl}"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full flex items-center justify-center gap-2.5 py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-all duration-300 shadow-lg shadow-emerald-600/25 active:scale-98"
              >
                ¡Quiero comprar este juego!
              </a>

            </div>

          </div>

        </div>
      `;

      /*
       * ======================================================
       * CERRAR MODAL
       * ======================================================
       */

      document
        .getElementById("close-modal")
        ?.addEventListener("click", closeModal);

      /*
       * ======================================================
       * PS4
       * ======================================================
       */

      document
        .getElementById("platform-ps4")
        ?.addEventListener("click", function () {
          currentPlatform = "PS4";
          renderModalContent();
        });

      /*
       * ======================================================
       * PS5
       * ======================================================
       */

      document
        .getElementById("platform-ps5")
        ?.addEventListener("click", function () {
          currentPlatform = "PS5";
          renderModalContent();
        });

      /*
       * ======================================================
       * SECUNDARIA
       * ======================================================
       */

      document
        .getElementById("toggle-sec")
        ?.addEventListener("click", function () {
          currentAccountType = "secundaria";
          renderModalContent();
        });

      /*
       * ======================================================
       * PRIMARIA
       * ======================================================
       */

      document
        .getElementById("toggle-pri")
        ?.addEventListener("click", function () {
          currentAccountType = "primaria";
          renderModalContent();
        });
    }

    /*
     * ========================================================
     * MOSTRAR MODAL
     * ========================================================
     */

    renderModalContent();

    modal.classList.remove("hidden");
    modal.classList.add("flex");

    document.body.style.overflow = "hidden";

    /*
     * Cerrar haciendo clic fuera del contenido.
     */

    modal.onclick = function (ev) {
      if (ev.target === modal) {
        closeModal();
      }
    };
  }

  /*
   * ==========================================================
   * CERRAR MODAL
   * ==========================================================
   */

  function closeModal() {
    const modal = document.getElementById("game-modal");

    if (!modal || !(modal instanceof HTMLElement)) return;

    modal.classList.add("hidden");
    modal.classList.remove("flex");

    document.body.style.overflow = "";
  }

  /*
   * ==========================================================
   * ESCAPE
   * ==========================================================
   */

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") {
      closeModal();
    }
  });
</script>
