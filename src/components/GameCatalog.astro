---
// src/components/GameCatalog.astro
import GameCard from './GameCard.astro';
import { games } from '../data/games';
---

<section id="catalogo" class="py-12 bg-slate-950 text-slate-100 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="font-gaming font-bold text-2xl sm:text-4xl text-white mb-3">
        CATÁLOGO DE <span class="bg-gradient-to-r from-amber-400 via-yellow-400 to-amber-500 bg-clip-text text-transparent">JUEGOS</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-400 max-w-2xl mx-auto">
        Explora nuestros títulos en formato digital para PS4 y PS5 con activación inmediata.
      </p>
    </div>

    <!-- Buscador y Filtro por Plataforma -->
    <div class="mb-8 flex flex-col md:flex-row items-center justify-between gap-4 bg-slate-900 p-4 rounded-2xl border border-slate-800 shadow-sm">
      <div class="relative w-full md:w-80">
        <input
          type="text"
          id="search-input"
          placeholder="Buscar juego por título..."
          class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 focus:border-amber-500 text-sm text-white focus:outline-none transition-all"
        />
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
        </svg>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-1 md:pb-0" id="platform-filters">
        <button data-filter="all" class="filter-btn active px-4 py-2 rounded-xl text-xs font-bold transition-all bg-gradient-to-r from-amber-500 to-yellow-500 text-black shadow-md">
          Todos
        </button>
        <button data-filter="PS4" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-800 text-slate-300 hover:bg-slate-700">
          PS4
        </button>
        <button data-filter="PS5" class="filter-btn px-4 py-2 rounded-xl text-xs font-bold transition-all bg-slate-800 text-slate-300 hover:bg-slate-700">
          PS5
        </button>
      </div>
    </div>

    <!-- Carrusel de Juegos (Máximo 4 por vista, pasados 1 a 1) -->
    <div class="relative group">
      <!-- Botón Anterior -->
      <button
        id="carousel-prev"
        class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-950/90 border border-amber-500/50 text-amber-400 flex items-center justify-center shadow-2xl hover:bg-amber-500 hover:text-slate-950 hover:scale-110 active:scale-95 transition-all duration-300"
        aria-label="Anterior"
      >
        <svg class="w-6 h-6 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <!-- Botón Siguiente -->
      <button
        id="carousel-next"
        class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 z-20 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-slate-950/90 border border-amber-500/50 text-amber-400 flex items-center justify-center shadow-2xl hover:bg-amber-500 hover:text-slate-950 hover:scale-110 active:scale-95 transition-all duration-300"
        aria-label="Siguiente"
      >
        <svg class="w-6 h-6 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      <!-- Contenedor del Carrusel (Max 4 cards en desktop lg) -->
      <div
        id="games-carousel"
        class="flex overflow-x-auto scroll-smooth snap-x snap-mandatory py-4 -mx-2 px-2 gap-5"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {games.map((game) => (
          <div
            class="game-card-slide w-full sm:w-[calc(50%-10px)] md:w-[calc(33.333%-14px)] lg:w-[calc(25%-15px)] flex-shrink-0 snap-start"
            data-platforms={game.platforms.map(p => p.name).join(',')}
          >
            <GameCard game={game} />
          </div>
        ))}
      </div>
    </div>

    <!-- Mensaje cuando no hay resultados -->
    <div id="no-results" class="hidden text-center py-12">
      <p class="text-slate-400 font-medium">No se encontraron juegos que coincidan con tu búsqueda.</p>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll('#platform-filters button');
    const cards = document.querySelectorAll('.game-card-slide') as NodeListOf<HTMLElement>;
    const noResults = document.getElementById('no-results');
    const carousel = document.getElementById('games-carousel');
    const btnPrev = document.getElementById('carousel-prev');
    const btnNext = document.getElementById('carousel-next');

    let currentFilter = 'all';
    let currentSearch = '';

    // Deslizar 1 tarjeta a la vez en el carrusel
    function scrollCarousel(direction: 'prev' | 'next') {
      if (!carousel) return;
      const visibleCards = Array.from(cards).filter(c => c.style.display !== 'none');
      if (visibleCards.length === 0) return;

      const cardWidth = visibleCards[0].offsetWidth + 20; // Ancho tarjeta + espaciado gap
      const scrollAmount = direction === 'next' ? cardWidth : -cardWidth;

      carousel.scrollBy({
        left: scrollAmount,
        behavior: 'smooth'
      });
    }

    btnPrev?.addEventListener('click', () => scrollCarousel('prev'));
    btnNext?.addEventListener('click', () => scrollCarousel('next'));

    function updateCatalog() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const titleEl = card.querySelector('h3');
        const title = titleEl ? titleEl.textContent?.toLowerCase() || '' : '';
        const platformsStr = card.getAttribute('data-platforms') || '';
        const platforms = platformsStr.split(',');

        const matchesSearch = title.includes(currentSearch);
        const matchesPlatform = currentFilter === 'all' || platforms.includes(currentFilter);

        if (matchesSearch && matchesPlatform) {
          card.style.display = 'block';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      if (carousel) {
        carousel.scrollTo({ left: 0, behavior: 'smooth' });
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase().trim();
      updateCatalog();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('bg-gradient-to-r', 'from-amber-500', 'to-yellow-500', 'text-black', 'shadow-md');
          b.classList.add('bg-slate-800', 'text-slate-300');
        });

        btn.classList.remove('bg-slate-800', 'text-slate-300');
        btn.classList.add('bg-gradient-to-r', 'from-amber-500', 'to-yellow-500', 'text-black', 'shadow-md');

        currentFilter = btn.getAttribute('data-filter') || 'all';
        updateCatalog();
      });
    });
  });
</script>